---
import "../styles/global.css";

import { ArrowUpRightIcon } from "lucide-solid";
import Head from "../components/astro/head.astro";
import Header from "../components/astro/header.astro";
import { NAVIGATIONS } from "../constants";

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	noIndex?: boolean;
}
const props = Astro.props;
---

<html data-theme="light" class="scroll-smooth" lang="en">
	<head>
		<Head
			title={props.title}
			description={props.description}
			canonical={Astro.url.pathname}
			noIndex={props.noIndex}
		/>

		<script is:inline>
			(() => {
				const themeState = localStorage.getItem("theme") || "system";
				const theme =
					themeState === "system"
						? window.matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light"
						: themeState;
				document.documentElement.setAttribute("data-theme", theme);
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
	</head>
	<body class="relative min-h-screen flex flex-col">
		<Header />
		<div
			class="grow px-6 md:px-12 mx-auto relative w-full z-10 bg-background origin-top rounded-b-[3rem] mb-125 md:mb-150"
		>
			<main
				class="max-w-7xl mx-auto mb-32 min-h-[calc(100vh-6rem*2)] flex flex-col justify-center"
			>
				<slot />
			</main>
		</div>
		<footer class="fixed bottom-0 inset-x-0 z-0 h-125 md:h-150">
			<div
				class="bg-[#0a0a0a] h-full flex flex-col justify-between px-6 pt-6 md:px-12 md:pt-24 pb-6 overflow-hidden relative"
			>
				<div
					class="flex flex-col md:flex-row justify-between items-start relative z-10"
				>
					<div class="max-w-xl mb-12 md:mb-0">
						<h2
							class="font-serif text-5xl md:text-7xl mb-8 leading-none text-white"
						>
							Have an idea? <br />
							<span class="text-[oklch(0.985_0_0)]/50 italic">
								Let's build it.
							</span>
						</h2>
						<a
							href="mailto:hi@alfanjauhari.com"
							class="group inline-flex items-center gap-3 text-sm font-mono uppercase tracking-widest border-b border-white/20 hover:border-white transition-all text-white"
						>
							<span>hi@alfanjauhari.com</span>
							<ArrowUpRightIcon
								class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform size-4"
							/>
						</a>
					</div>

					<div class="flex gap-12 md:gap-24">
						<div class="space-y-4">
							<p
								class="text-xs font-mono text-[oklch(0.985_0_0)]/50 uppercase tracking-widest"
							>
								Connect
							</p>
							<div class="flex flex-col gap-2">
								<a
									href="https://github.com/alfanjauhari"
									class="text-lg text-white/50 hover:text-white duration-300"
									target="_blank"
									rel="noreferrer noopener"
								>
									Github
								</a>
								<a
									href="https://linkedin.com/in/m-alfanjauhari"
									class="text-lg text-white/50 hover:text-white duration-300"
									target="_blank"
									rel="noreferrer noopener"
								>
									LinkedIn
								</a>
								<a
									href="https://x.com/alfanjauhari_"
									class="text-lg text-white/50 hover:text-white duration-300"
									target="_blank"
									rel="noreferrer noopener"
								>
									X / Twitter
								</a>
							</div>
						</div>
						<div class="space-y-4">
							<p
								class="text-xs font-mono text-[oklch(0.985_0_0)]/50 uppercase tracking-widest"
							>
								Explore
							</p>
							<div class="flex flex-col gap-2">
								{
									NAVIGATIONS.map((nav) => (
										<a
											href={nav.path}
											class="text-lg text-white/50 hover:text-white duration-300"
										>
											{nav.label}
										</a>
									))
								}
							</div>
						</div>
					</div>
				</div>
				<div class="relative w-full mt-12 md:mt-0">
					<p
						class="text-[28vw] lg:text-[22vw] leading-[0.8] font-serif font-bold text-center tracking-tighter text-transparent bg-clip-text bg-linear-to-b from-white/10 to-transparent select-none pointer-events-none w-full absolute bottom-0"
					>
						ALFAN
					</p>

					<div
						class="absolute bottom-2 w-full flex justify-between text-xxs font-mono uppercase tracking-widest text-[oklch(0.985_0_0)]/60 px-2"
					>
						<div class="flex gap-4">
							<span>&copy; {new Date().getFullYear()}</span>
							<span class="hidden md:inline">All Rights Reserved</span>
						</div>
						<span>Tulungagung, ID</span>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
