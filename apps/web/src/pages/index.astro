---
import { ArrowRightIcon, ArrowUpRightIcon, MapPinIcon } from "lucide-solid";
import InteractiveTitle from "../components/solid/interactive-title";
import BaseLayout from "../layouts/base-layout.astro";
import { getAllUpdates, getAllWorks } from "../lib/content";
import { calculateReadingTime, formatDate } from "../lib/utils";
import { Button } from "../components/solid/ui/button";

const works = await getAllWorks();
const updates = await getAllUpdates();

const process = [
	{
		id: "01",
		title: "Discovery",
		desc: "Understanding constraints, user needs, and business goals.",
	},
	{
		id: "02",
		title: "Strategy",
		desc: "Defining the architecture, tech stack, and design system.",
	},
	{
		id: "03",
		title: "Build",
		desc: "Iterative development with a focus on performance and accessibility.",
	},
	{
		id: "04",
		title: "Refine",
		desc: "Polishing interactions, optimizing assets, and ensuring quality.",
	},
];
---

<BaseLayout
	description="A passionate Product Engineer. I build pixel-perfect interfaces and scalable systems for the web."
>
	<section id="hero" class="flex flex-col justify-center relative z-10 mb-40">
		<div class="my-16 xl:mb-24">
			<InteractiveTitle client:load />
		</div>

		<div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-12">
			<div class="space-y-6">
				<p class="text-xl md:text-2xl leading-tight font-normal max-w-2xl">
					A passionate{" "}
					<span class="italic font-serif">Product Engineer</span>. I build{" "}
					<span class="font-serif italic">pixel-perfect</span>{" "}
					interfaces and scalable systems for everyone.
				</p>
				<div class="flex flex-col md:flex-row gap-4">
					<Button variant="default" size="xl" as="a" href="#works">
						View Works
					</Button>
					<Button
						variant="outline"
						size="xl"
						as="a"
						href="mailto:hi@alfanjauhari.com"
					>
						Contact Me
					</Button>
				</div>
			</div>
			<div
				class="flex flex-col justify-between items-start md:items-end text-left md:text-right"
			>
				<div class="space-y-1">
					<div class="flex items-center md:justify-end gap-2">
						<MapPinIcon class="size-4" />
						<span class="text-sm font-bold">Tulungagung, ID</span>
					</div>
					<span class="font-mono text-xs text-foreground/40 block">
						8.0912&deg; S, 111.9642&deg; E
					</span>
				</div>
			</div>
		</div>
	</section>

	<section id="methodology" class="mb-40" data-motion-reveal>
		<h2 class="font-serif text-5xl md:text-6xl mb-16">Methodology</h2>

		<div class="methodology-track grid grid-cols-1 gap-8 md:grid-cols-4">
			<div class="methodology-line" aria-hidden="true"></div>
			{
				process.map((step, index) => (
					<article
						class="methodology-step group relative flex flex-col"
						data-motion-item
						style={`--motion-delay: ${index * 110}ms`}
						tabindex="0"
					>
						<div class="methodology-heading mb-6 flex items-center">
							<span class="methodology-index block w-fit shrink-0 bg-background font-mono text-sm text-foreground/40">
								{step.id}
							</span>
							<span class="methodology-segment" aria-hidden="true"></span>
						</div>
						<div>
							<h3 class="mb-4 font-serif text-3xl transition-transform duration-300 group-hover:translate-x-2 group-focus-visible:translate-x-2">
								{step.title}
							</h3>
							<p class="text-sm text-foreground/60 leading-relaxed font-normal">
								{step.desc}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="works" class="mb-40 scroll-mt-36">
		<h2 class="font-serif text-5xl md:text-6xl mb-16">Featured Works</h2>
		<div class="flex flex-col gap-12 pb-24">
			{
				works.map((work) => (
					<div class="work-card-stage sticky top-30">
						<article
							class="work-card group relative flex h-125 flex-col overflow-hidden rounded-lg border border-border bg-background md:flex-row"
							data-pointer-tilt
							data-tilt-max="4"
							data-tilt-parallax="10"
						>
							<a
								href={`/works/${work.id}`}
								class="work-card-link absolute inset-0 z-40"
								aria-label={`Learn more about ${work.data.title}...`}
							/>
							<div class="work-card-media relative w-full cursor-pointer overflow-hidden md:w-1/2 lg:w-7/12">
								<div
									class="work-card-image absolute -inset-3 bg-cover bg-center bg-no-repeat grayscale duration-700 ease-out group-hover:grayscale-0"
									data-tilt-layer="image"
									style={`background-image: url(${work.data.thumbnail})`}
								/>
								<div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
									<div class="bg-background text-foreground px-6 py-3 rounded-full opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-500 font-mono text-xs uppercase tracking-widest border border-border">
										Learn More
									</div>
								</div>
							</div>
							<div
								class="work-card-content relative z-30 flex w-full flex-col justify-between p-8 md:w-1/2 lg:w-5/12 lg:p-12"
								data-tilt-layer="content"
							>
								<div>
									<div class="flex justify-between items-start mb-6">
										<span class="text-xs font-mono">{work.data.year}</span>
										<ArrowUpRightIcon class="size-5" />
									</div>
									<h3 class="font-serif text-4xl mb-6 leading-tight">
										{work.data.title}
									</h3>
									<p class="leading-relaxed mb-8 line-clamp-4">
										{work.data.summary}
									</p>
								</div>

								<div class="flex flex-wrap gap-2">
									{work.data.techstack.map((tech: string) => (
										<div class="border border-border text-foreground/50 text-xxs px-4 py-2 tracking-widest uppercase">
											{tech}
										</div>
									))}
								</div>
							</div>
						</article>
					</div>
				))
			}
		</div>
	</section>

	<section id="updates">
		<div class="flex items-end justify-between mb-16">
			<h2 class="font-serif text-5xl md:text-6xl">Latest Updates</h2>
			<a
				href="/updates"
				class="hidden md:flex items-center gap-2 text-xs font-mono uppercase tracking-widest hover:underline"
			>
				<span>Read All</span>
				<ArrowRightIcon class="size-3" />
			</a>
		</div>

		<div class="space-y-16">
			{
				updates.slice(0, 3).map((update) => (
					<a href={`/updates/${update.id}`} class="group block">
						<article class="flex flex-col md:flex-row md:items-baseline justify-between gap-8">
							<div class="md:w-3/4">
								<h3 class="font-serif text-3xl md:text-4xl group-hover:opacity-60 transition-opacity duration-300 leading-tight mb-4">
									{update.data.title}
								</h3>
								<p class="font-normal leading-relaxed max-w-2xl text-foreground/70">
									{update.data.summary}
								</p>
							</div>
							<div class="md:w-1/4 md:text-right flex flex-row md:flex-col gap-4 md:gap-0 items-center md:items-end">
								<span class="font-mono text-xs text-foreground/50 uppercase tracking-widest mb-2">
									{formatDate(update.data.date)}
								</span>
								<span class="font-mono text-xxs text-foreground/50 uppercase tracking-widest">
									{update.body ? calculateReadingTime(update.body) : 1} Minute
									Reading Time
								</span>
							</div>
						</article>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>

<script>
	import { initializeMotion } from "../lib/motion";

	initializeMotion();
</script>
