---
import { ArrowUpRightIcon } from "lucide-solid";
import BaseLayout from "@/layouts/base-layout.astro";
import { getAllUpdates } from "../../lib/content";
import { calculateReadingTime, formatDate } from "../../lib/utils";

const updates = await getAllUpdates();
---

<BaseLayout
	title="Updates"
	description="A collection of my thoughts on software engineering, design systems, and the intersection of humanity and technology."
>
	<div class="mt-12">
		<div class="max-w-2xl mb-24">
			<h1 class="font-serif text-6xl md:text-8xl mb-8 tracking-tight">
				Updates.
			</h1>
			<p
				class="text-lg md:text-xl text-foreground/60 font-normal leading-relaxed"
			>
				A collection of thoughts on software engineering, design systems, and
				the intersection of humanity and technology.
			</p>
		</div>

		<div class="flex flex-col gap-y-12 lg:gap-y-24">
			{
				updates.map((update) => (
					<a href={`/updates/${update.id}`}>
						<article class="group cursor-pointer">
							<div class="flex flex-col md:flex-row justify-between gap-8 mb-4">
								<h3 class="font-serif text-4xl md:text-6xl group-hover:opacity-70 transition-opacity duration-300 max-w-4xl">
									{update.data.title}
								</h3>
								<ArrowUpRightIcon class="opacity-0 group-hover:opacity-100 transition-all duration-300 transform group-hover:translate-x-2 group-hover:-translate-y-2 size-12 hidden lg:block" />
							</div>
							<div class="flex gap-4 md:gap-8 mt-6 mb-8 text-xs font-mono uppercase tracking-widest text-foreground/50 flex-wrap">
								<span>{formatDate(update.data.date)}</span>
								{update.data.tag && (
									<>
										<span class="text-foreground/30">/</span>
										<span>{update.data.tag}</span>
									</>
								)}
								<span class="text-foreground/30">/</span>
								<span>
									{update.body ? calculateReadingTime(update.body) : 1} Minute
									Reading Time
								</span>
							</div>
							<p class="text-foreground/60 font-normal max-w-2xl leading-relaxed">
								{update.data.summary}
							</p>
						</article>
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>
