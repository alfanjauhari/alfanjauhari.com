---
import { FeedsList } from "../../components/solid/feeds-list";
import BaseLayout from "@/layouts/base-layout.astro";
import { getPublicFeedsData } from "../../lib/feeds";

export const prerender = false;

const { items, hasMore } = await getPublicFeedsData();
---

<BaseLayout
	title="Feeds"
	description="Short-form life updates, OSS contributions, new features, discoveries, and whatever else is happening."
	canonical="/feeds"
>
	<div class="max-w-2xl mb-24">
		<h1 class="font-serif text-6xl md:text-8xl mb-8 tracking-tight">Feeds</h1>
		<p
			class="text-lg md:text-xl text-foreground/60 font-normal leading-relaxed"
		>
			Short-form life updates, OSS contributions, new features, discoveries, and
			whatever else is happening.
		</p>
	</div>

	<FeedsList initialItems={items} initialHasMore={hasMore} client:load />
</BaseLayout>
