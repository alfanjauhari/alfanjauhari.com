---
import BaseLayout from "@/layouts/base-layout.astro";
import SnippetsList from "@/components/astro/snippets-list.astro";

export const prerender = false;
---

<BaseLayout
	title="Snippets"
	description="A collection of copy-pasteable code blocks, utility functions, and hooks I use across my projects."
>
	<div class="mt-12">
		<div class="max-w-2xl mb-24">
			<h1 class="font-serif text-6xl md:text-8xl mb-8 tracking-tight">
				Snippets.
			</h1>
			<p class="text-lg md:text-xl text-foreground/60 font-normal leading-relaxed">
				A collection of copy-pasteable code blocks, utility functions, and hooks
				I use across my projects.
			</p>
		</div>

		<SnippetsList />
	</div>
</BaseLayout>
