---
import { HeartIcon, MessageSquareIcon } from "lucide-solid";
import { LogoutButton } from "../../components/solid/dashboard/logout-button";
import { UserGreeting } from "../../components/solid/dashboard/name-editor";
import BaseLayout from "@/layouts/base-layout.astro";
import { commentStatusMap } from "../../lib/comments";
import { getUserCommentsData, getUserLikesData } from "../../lib/dashboard";
import { cn, formatDate } from "../../lib/utils";

export const prerender = false;

if (!Astro.locals.session || !Astro.locals.user) {
	return Astro.redirect("/auth/login");
}

const user = Astro.locals.user;

const [{ likes, count: likesCount }, { comments, count: commentsCount }] =
	await Promise.all([getUserLikesData(user.id), getUserCommentsData(user.id)]);
---

<BaseLayout
	title="Dashboard"
	description="Manage your account, likes and comments in one single place."
	noIndex
>
	<div class="mb-12 flex items-center justify-between">
		<div>
			<UserGreeting name={user.name || "John Doe"} client:load />
			<p class="font-mono text-sm text-foreground/50">
				Member since {formatDate(user.createdAt)}
			</p>
		</div>

		<LogoutButton client:load />
	</div>

	<section class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12">
		<div class="space-y-4">
			<div class="flex items-center gap-2">
				<HeartIcon class="size-6" />
				<span>Like History</span>
				<span
					class="size-6 rounded-full bg-foreground/10 text-xs flex items-center justify-center"
				>
					{likesCount}
				</span>
			</div>
			<hr />
			<div class="space-y-4">
				{
					likes.map((like) => (
						<div class="p-4 bg-foreground/10 space-y-2">
							<a
								href={`/updates/${like.update.slug}`}
								class="font-serif text-lg inline-block"
							>
								{like.update.title}
							</a>
							<p class="font-mono text-sm text-foreground/50">
								{formatDate(new Date(like.createdAt))}
							</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="space-y-4">
			<div class="flex items-center gap-2">
				<MessageSquareIcon class="size-6" />
				<span>Comment History</span>
				<span
					class="size-6 rounded-full bg-foreground/10 text-xs flex items-center justify-center"
				>
					{commentsCount}
				</span>
			</div>
			<hr />
			<div class="space-y-4">
				{
					comments.map((comment) => (
						<div class="px-4 border-l-2 border-l-foreground/30 space-y-4">
							<div class="flex justify-between items-center gap-4">
								<a href={`/updates/${comment.update.slug}`} class="font-serif">
									{comment.update.title}
								</a>
								<span
									class={cn(
										"font-mono p-1 bg-foreground uppercase text-xxs text-accent",
										{
											"bg-red-600 text-foreground":
												comment.status === "deleted",
										},
									)}
								>
									{commentStatusMap(comment.status)}
								</span>
							</div>
							<div class="italic text-foreground/70 line-clamp-3">
								"{comment.content}"
							</div>
							<p class="font-mono text-sm text-foreground/50">
								{formatDate(new Date(comment.createdAt))}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
