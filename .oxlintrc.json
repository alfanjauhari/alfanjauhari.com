{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // it seems the "no-unassigned-vars" rule is not working properly with solid-js, so we disable it for now
    "no-unassigned-vars": "off"
  },
  "env": {
    "builtin": true
  }
}
