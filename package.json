{
  "name": "alfanjauhari.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "astro": "pnpm --filter @alfanjauhari/web astro",
    "build": "turbo build",
    "db:generate": "pnpm --filter @alfanjauhari/web db:generate",
    "db:migrate": "pnpm --filter @alfanjauhari/web db:migrate",
    "deploy": "pnpm --filter @alfanjauhari/web deploy",
    "dev": "turbo dev --filter=@alfanjauhari/web...",
    "format": "pnpm --filter @alfanjauhari/config build && oxfmt",
    "format:check": "pnpm --filter @alfanjauhari/config build && oxfmt --check",
    "generate-types": "pnpm --filter @alfanjauhari/web generate-types",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "preview": "pnpm --filter @alfanjauhari/web preview",
    "release": "turbo run build lint typecheck && changeset publish",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@alfanjauhari/config": "workspace:*",
    "@changesets/cli": "^3.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0"
}
