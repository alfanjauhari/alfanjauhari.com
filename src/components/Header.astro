---
import { NAVIGATIONS } from "../constants";
import { cn } from "../lib/utils";
import ThemeToggle from "./solid/ThemeToggle";

const currentPath = Astro.url.pathname;

const isActive = (path: string) =>
	currentPath === path || (path !== "/" && currentPath.startsWith(path));
---

<header
	class="sticky top-0 z-50 flex justify-between items-center md:px-12 bg-background/80 backdrop-blur-md border-b border-transparent dark:border-border/50 h-24 px-6"
>
	<a
		href="/"
		class="font-serif text-2xl font-bold tracking-tighter hover:opacity-70 transition-opacity text-foreground relative z-50"
		title="Alfan Jauhari"
	>
		AJ.
	</a>

	<nav
		class="hidden md:flex items-center gap-8 text-sm font-medium tracking-widest uppercase text-foreground"
	>
		<ul class="flex items-center gap-6 lg:gap-8">
			{
				NAVIGATIONS.filter((nav) => !nav.hideOnNav).map((nav) => (
					<li>
						<a
							href={nav.path}
							class={cn(
								"hover:line-through decoration-1 underline-offset-4",
								{
									"line-through": isActive(nav.path),
								},
							)}
						>
							{nav.label}
						</a>
					</li>
				))
			}
			<ThemeToggle />
		</ul>
	</nav>

	<div class="flex items-center gap-4 md:hidden text-foreground">
		<ThemeToggle />
		<button
			id="mobile-menu-toggle"
			aria-label="Toggle Mobile Menu"
			class="size-10 rounded-full flex items-center justify-center hover:bg-accent transition-colors"
			type="button"
		>
			<svg
				id="menu-icon"
				xmlns="http://www.w3.org/2000/svg"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-5"
			>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
		</button>
	</div>
</header>

<nav
	id="mobile-menu"
	class="fixed inset-0 z-40 bg-background flex-col items-center justify-center md:hidden hidden"
	aria-hidden="true"
>
	<ul class="flex flex-col items-center gap-8">
		{
			NAVIGATIONS.filter((nav) => !nav.hideOnNav).map((nav) => (
				<li>
					<a
						href={nav.path}
						class={cn(
							"font-serif text-4xl text-foreground hover:line-through decoration-1 underline-offset-4",
							{
								"line-through": isActive(nav.path),
							},
						)}
					>
						{nav.label}
					</a>
				</li>
			))
		}
	</ul>
	<p
		class="absolute bottom-12 text-xs font-mono uppercase tracking-widest text-foreground"
	>
		&copy; {new Date().getFullYear()} Alfan Jauhari
	</p>
</nav>

<script>
	const toggle = document.getElementById("mobile-menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const icon = document.getElementById("menu-icon");
	let open = false;

	toggle?.addEventListener("click", () => {
		open = !open;
		if (open) {
			menu?.classList.remove("hidden");
			menu?.classList.add("flex");
			if (icon)
				icon.innerHTML =
					'<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>';
		} else {
			menu?.classList.add("hidden");
			menu?.classList.remove("flex");
			if (icon)
				icon.innerHTML =
					'<line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>';
		}
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			open = false;
			menu?.classList.add("hidden");
			menu?.classList.remove("flex");
			if (icon)
				icon.innerHTML =
					'<line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>';
		});
	});
</script>
