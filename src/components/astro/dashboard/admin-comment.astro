---
import { ReplyIcon } from "lucide-solid";
import type { TreeNode } from "@/lib/comments";
import type { AdminComment } from "@/lib/dashboard";
import { cn, formatDate } from "@/lib/utils";
import CommentRecord from "./admin-comment.astro";

interface Props {
	comment: TreeNode<AdminComment>;
}

const { comment } = Astro.props;
---

<div
	id={`comment-${comment.id}`}
	class={cn(
		"border border-border p-6 block hover:border-foreground duration-300 group target:outline scroll-mt-32",
		{
			"mt-4": comment.parentId,
		},
	)}
>
	<div class="flex items-center justify-between">
		<div>
			<div class="flex items-center gap-2 mb-4">
				<div class="font-serif">{comment.user.name}</div>
				{
					comment.parent?.user && (
						<a
							href={`#comment-${comment.parentId}`}
							class="text-foreground/50 flex items-center gap-2"
						>
							<ReplyIcon class="size-3 rotate-180" />
							<span class="uppercase font-mono text-xxs">
								Replied to {comment.parent.user.name}
							</span>
						</a>
					)
				}
			</div>
			<div class="flex gap-4 text-xs font-mono text-foreground/40 mb-4">
				<span>{formatDate(new Date(comment.createdAt))}</span>
				<span>&bull;</span>
				<a href={`/updates/${comment.update.slug}`}>{comment.update.title}</a>
			</div>
			<blockquote class="pl-3 py-1 border-l-2 border-l-border text-sm italic">
				{comment.content}
			</blockquote>
		</div>
	</div>
	{
		comment.replies.map((reply) => (
			<CommentRecord comment={reply} />
		))
	}
</div>
