---
import { getCollection, getEntry, render } from "astro:content";
import Image from "@/components/mdx/image.astro";
import Playground from "@/components/mdx/playground.astro";
import PlaygroundFile from "@/components/mdx/playground-file.astro";
import Pre from "@/components/mdx/pre.astro";
import Serif from "@/components/mdx/serif.astro";
import UpdateLayout from "@/layouts/update-layout.astro";
import { calculateReadingTime } from "@/lib/utils";

export async function getStaticPaths() {
	const updates = await getCollection("updates");
	return updates
		.filter((u) => !u.data.draft)
		.map((entry) => ({
			params: { id: entry.id },
		}));
}

const { id } = Astro.params;
const entry = await getEntry("updates", id);

if (!entry) return new Response(null, { status: 404 });

const { Content } = await render(entry);
const readingTime = entry.body ? calculateReadingTime(entry.body) : 1;
---

<UpdateLayout
	title={entry.data.title}
	tag={entry.data.tag}
	summary={entry.data.summary}
	date={entry.data.date}
	readingTime={readingTime}
	id={id}
>
	<Content components={{ Image, Playground, PlaygroundFile, Sandpack: Playground, SandpackFile: PlaygroundFile, serif: Serif, pre: Pre }} />
</UpdateLayout>
