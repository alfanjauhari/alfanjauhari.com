---
import { getCollection, getEntry, render } from "astro:content";
import { TerminalIcon } from "lucide-solid";
import Image from "@/components/mdx/image.astro";
import Playground from "@/components/mdx/playground.astro";
import PlaygroundFile from "@/components/mdx/playground-file.astro";
import Pre from "@/components/mdx/pre.astro";
import Serif from "@/components/mdx/serif.astro";
import BaseLayout from "@/layouts/base-layout.astro";

export async function getStaticPaths() {
	const snippets = await getCollection("snippets");
	return snippets.map((entry) => ({
		params: { id: entry.id },
	}));
}

const { id } = Astro.params;
const entry = await getEntry("snippets", id);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.summary}
	image={`/images/og/snippets/${id}.webp`}
>
	<div class="min-h-screen mt-12">
		<div class="max-w-5xl mx-auto">
			<header class="mb-20">
				<div class="flex items-center gap-3 mb-6 text-xs font-mono uppercase tracking-widest text-foreground/40">
					<TerminalIcon class="size-3.5" />
					<span>{entry.data.language}</span>
					<span class="text-foreground/30">&bull;</span>
					{
						entry.data.tags.map((tag: string) => (
							<span>{tag}</span>
						))
					}
				</div>

				<h1 class="font-serif text-4xl md:text-6xl leading-none mb-6">
					{entry.data.title}
				</h1>

				<p class="text-xl mb-12 text-foreground/40">
					{entry.data.summary}
				</p>
			</header>

			<article class="prose-primary prose-lg md:prose-xl max-w-full prose-headings:leading-tight prose-headings:font-serif">
				<Content components={{ Image, Playground, PlaygroundFile, Sandpack: Playground, SandpackFile: PlaygroundFile, serif: Serif, pre: Pre }} />
			</article>
		</div>
	</div>
</BaseLayout>
