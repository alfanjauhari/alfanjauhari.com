---
import BaseLayout from "../layouts/base-layout.astro";
import DotTitle from "../components/astro/dot-title.astro";
---

<BaseLayout
	title="Uses"
	description="A living collection of the hardware, software, and office gear I use on a daily basis to build software."
>
	<div class="mt-12">
		<div class="max-w-2xl mb-24">
			<h1 class="font-serif text-6xl md:text-8xl mb-8 tracking-tight">
				Uses
			</h1>
			<p class="text-lg md:text-xl text-foreground/60 font-normal leading-relaxed">
				A living collection of the hardware, software, and office gear I use on
				a daily basis to build software.
			</p>
		</div>

		<!-- Workstation -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24 border-t border-border pt-24 first:border-0 first:pt-0">
			<div class="lg:col-span-4">
				<div class="sticky top-32">
					<DotTitle>Workstation</DotTitle>
					<p class="text-foreground/50 font-mono text-xs leading-relaxed max-w-xs">
						The hardware backbone to support my needs for tinkering and
						developing beautiful software.
					</p>
				</div>
			</div>
			<div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
				<div class="group md:col-span-2 border border-border p-8 rounded-sm">
					<div class="mb-8">
						<h3 class="font-serif text-3xl mb-4">Custom Build PC</h3>
						<p class="text-base text-foreground/60 font-normal leading-relaxed max-w-2xl">
							A dedicated PC with Windows 11 and Ubuntu as my secondary
							operating system (actually it just for gaming and college stuff)
						</p>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 border-t border-border pt-6">
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">Case</span>
							<span class="font-serif text-lg text-end">Cube Gaming Lich Black</span>
						</div>
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">CPU</span>
							<span class="font-serif text-lg text-end">AMD Ryzen 5 5500</span>
						</div>
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">GPU</span>
							<span class="font-serif text-lg text-end">AMD Radeon RX 6600</span>
						</div>
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">RAM</span>
							<span class="font-serif text-lg text-end">32GB Corsair Vengeance</span>
						</div>
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">Storage</span>
							<span class="font-serif text-lg text-end">2TB (Klevv, Samsung and Team Group SSD)</span>
						</div>
						<div class="grid grid-cols-[5rem_1fr] items-center border-b border-border/50 pb-2">
							<span class="font-mono text-xxs uppercase tracking-widest text-foreground/50">Cooling</span>
							<span class="font-serif text-lg text-end">ID-COOLING SE-214-XT</span>
						</div>
					</div>
				</div>

				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Mac Mini M4
					</h3>
					<p class="leading-relaxed">
						A monster that hides behind the word "mini". This is my main
						workspace for software development.
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						MacBook Air M1 (2020)
					</h3>
					<p class="leading-relaxed">
						My main laptop which basically used when I need to go out or join
						meeting because my other computer doesn't have a mic & camera lol
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Keychron K3
					</h3>
					<p class="leading-relaxed">
						The best mechanical keyboard so far. It can connected up to 3
						devices and easily switch device by holding some keys
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Logitech Superlight
					</h3>
					<p class="leading-relaxed">
						Buy this mouse to play some competitive FPS games and definitly
						worth every penny
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Kanata+ Karya
					</h3>
					<p class="leading-relaxed">
						An adjustable desk with large space to hold my workstation
						well-organized without headache
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Pexio Milson
					</h3>
					<p class="leading-relaxed">
						Move to this ergonomic chair to make my posture stay good
					</p>
				</div>
			</div>
		</div>

		<!-- Software -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24 border-t border-border pt-24">
			<div class="lg:col-span-4">
				<div class="sticky top-32">
					<DotTitle>Software</DotTitle>
					<p class="text-foreground/50 font-mono text-xs leading-relaxed max-w-xs">
						The digital tools that enable my creativity and supporting my
						development workflow.
					</p>
				</div>
			</div>
			<div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Zed
					</h3>
					<p class="leading-relaxed">
						Very fast IDE that actually worked for my development workflow
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Zen
					</h3>
					<p class="leading-relaxed">
						A firefox based browser with beautifully and easy to use tab
						management
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Raycast
					</h3>
					<p class="leading-relaxed">
						Spotlight replacement on steroids. I use it for window management,
						running quick scripts, clipboard history and more
					</p>
				</div>
				<div class="group">
					<h3 class="font-serif text-2xl mb-4 group-hover:text-foreground/60 transition-colors">
						Ghostty
					</h3>
					<p class="leading-relaxed">
						Lightweight terminal alternative that cover anything for my needs
					</p>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
