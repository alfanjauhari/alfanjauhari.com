---
import WorkLayout from "../../layouts/WorkLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import Image from "../../components/mdx/Image.astro";
import Sandpack from "../../components/mdx/Sandpack.astro";
import SandpackFile from "../../components/mdx/SandpackFile.astro";
import Serif from "../../components/mdx/Serif.astro";

export async function getStaticPaths() {
	const works = await getCollection("works");
	return works.map((entry) => ({
		params: { id: entry.id },
	}));
}

const { id } = Astro.params;
const entry = await getEntry("works", id!);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
---

<WorkLayout entry={entry}>
	<Content components={{ Image, Sandpack, SandpackFile, serif: Serif }} />
</WorkLayout>
