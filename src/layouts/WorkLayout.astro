---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	entry: CollectionEntry<"works">;
}

const { entry } = Astro.props;

const getTechIcon = (tech: string) => {
	const lower = tech.toLowerCase();
	if (lower.includes("react") || lower.includes("next")) return "layout";
	if (lower.includes("typescript") || lower.includes("js")) return "code";
	if (lower.includes("data") || lower.includes("sql") || lower.includes("d3"))
		return "database";
	if (lower.includes("node") || lower.includes("api")) return "terminal";
	if (lower.includes("shopify") || lower.includes("web")) return "globe";
	return "cpu";
};
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.summary}
	image={`/images/og/works/${entry.id}.webp`}
>
	<div class="min-h-screen mt-12">
		<header class="mb-40">
			<a
				href="/"
				class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-foreground/60 hover:text-foreground mb-12 transition-colors group"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="group-hover:-translate-x-1 transition-transform size-3.5"
				>
					<path d="m12 19-7-7 7-7" />
					<path d="M19 12H5" />
				</svg>
				Back to Home
			</a>

			<h1 class="font-serif text-6xl md:text-8xl mb-8 tracking-tight leading-[0.9]">
				{entry.data.title}
			</h1>

			<p class="text-xl md:text-2xl font-normal text-foreground/60 max-w-2xl leading-relaxed">
				{entry.data.summary}
			</p>
		</header>

		<section>
			<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
				<div class="md:col-span-3">
					<div class="sticky top-32 space-y-12">
						<div class="grid grid-cols-2 md:grid-cols-1 gap-8">
							<div>
								<h3 class="text-xxs font-bold uppercase tracking-widest text-foreground/50 mb-2">
									Client
								</h3>
								<p class="font-serif text-lg">{entry.data.client}</p>
							</div>
							<div>
								<h3 class="text-xxs font-bold uppercase tracking-widest text-foreground/50 mb-2">
									Role
								</h3>
								<p class="font-serif text-lg">{entry.data.role}</p>
							</div>
							<div>
								<h3 class="text-xxs font-bold uppercase tracking-widest text-foreground/50 mb-2">
									Year
								</h3>
								<p class="font-serif text-lg">{entry.data.year}</p>
							</div>
						</div>

						<div>
							<h3 class="text-xxs font-bold uppercase tracking-widest text-foreground/50 mb-4">
								Technologies Used
							</h3>
							<div class="flex flex-col gap-2">
								{
									entry.data.techstack.map((tech: string) => (
										<div class="flex items-center gap-3 p-3 border border-border rounded-sm hover:border-foreground transition-colors group">
											<span class="text-foreground/40 transition-colors">
												{getTechIcon(tech) === "code" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<polyline points="16 18 22 12 16 6" />
														<polyline points="8 6 2 12 8 18" />
													</svg>
												)}
												{getTechIcon(tech) === "layout" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<rect width="18" height="18" x="3" y="3" rx="2" />
														<path d="M3 9h18" />
														<path d="M9 21V9" />
													</svg>
												)}
												{getTechIcon(tech) === "terminal" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<polyline points="4 17 10 11 4 5" />
														<line x1="12" x2="20" y1="19" y2="19" />
													</svg>
												)}
												{getTechIcon(tech) === "database" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<ellipse cx="12" cy="5" rx="9" ry="3" />
														<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
														<path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
													</svg>
												)}
												{getTechIcon(tech) === "globe" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<circle cx="12" cy="12" r="10" />
														<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
														<path d="M2 12h20" />
													</svg>
												)}
												{getTechIcon(tech) === "cpu" && (
													<svg
														xmlns="http://www.w3.org/2000/svg"
														width="16"
														height="16"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
													>
														<rect width="16" height="16" x="4" y="4" rx="2" />
														<rect width="6" height="6" x="9" y="9" rx="1" />
														<path d="M15 2v2" />
														<path d="M15 20v2" />
														<path d="M2 15h2" />
														<path d="M2 9h2" />
														<path d="M20 15h2" />
														<path d="M20 9h2" />
														<path d="M9 2v2" />
														<path d="M9 20v2" />
													</svg>
												)}
											</span>
											<span class="text-sm font-mono">{tech}</span>
										</div>
									))
								}
							</div>
						</div>

						{
							entry.data.link && (
								<a
									href={entry.data.link}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-12 px-8 text-base w-full border border-border"
								>
									Live Website
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="14"
										height="14"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="size-3.5"
									>
										<path d="M7 7h10v10" />
										<path d="M7 17 17 7" />
									</svg>
								</a>
							)
						}
					</div>
				</div>

				<div class="md:col-span-9 md:pl-12">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-24">
						<div class="border border-border p-8 rounded-sm">
							<div class="flex items-center gap-3 mb-6">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-6 text-red-600"
								>
									<circle cx="12" cy="12" r="10" />
									<line x1="12" x2="12" y1="8" y2="12" />
									<line x1="12" x2="12.01" y1="16" y2="16" />
								</svg>
								<h2 class="font-serif text-3xl">The Challenge</h2>
							</div>
							<div class="prose prose-lg prose-primary max-w-none text-foreground/60 font-normal leading-relaxed">
								<p>{entry.data.challenge}</p>
							</div>
						</div>

						<div class="border border-border p-8 rounded-sm relative overflow-hidden">
							<div class="absolute top-0 right-0 p-4 opacity-5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="128"
									height="128"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-32"
								>
									<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
									<path d="M9 18h6" />
									<path d="M10 22h4" />
								</svg>
							</div>
							<div class="flex items-center gap-3 mb-6 relative z-10">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-6 text-green-600"
								>
									<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
									<polyline points="22 4 12 14.01 9 11.01" />
								</svg>
								<h2 class="font-serif text-3xl">The Solution</h2>
							</div>
							<div class="prose prose-lg prose-primary max-w-none text-foreground/60 font-normal leading-relaxed relative z-10">
								<p>{entry.data.solution}</p>
							</div>
						</div>
					</div>

					<article class="prose-primary prose-lg md:prose-xl max-w-full prose-headings:leading-tight prose-headings:font-serif">
						<slot />
					</article>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
